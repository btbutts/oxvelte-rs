/scripts/get-fixtures/bun.lock

# Generated by build.rs (see docs/research/css/property-awareness-lib.md)
/resources/css/known_css_properties.json

# Vendor (cloned by prepare.sh)
/vendor/
/vendors/

# Test fixtures: the pinned upstream trees are fetched on demand by
# `cargo get-svelte-fixtures` / `cargo get-eslint-fixtures` (run automatically
# by scripts/dev-setup.sh) — see docs/research/test/pinned-rules.md. Our own
# hand-maintained cases stay tracked: fixtures/linter/local/ and
# fixtures/parser/local/.
/fixtures/linter/upstream/
/fixtures/linter/manifest.json
# Version-only typescript marker written by `cargo get-eslint-fixtures` for
# tsrs eligibility detection inside the fixtures tree.
/fixtures/linter/node_modules/
/fixtures/parser/upstream/

